# JWT
JWT_SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria_antes_de_produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_HOURS=8

# Proveedor LLM — usa UNA de las dos opciones

# Opción A: Ollama local (recomendado si tienes 16GB RAM)
# Poner la IP de la máquina que corre Ollama en la red local
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b

# Opción B: OpenRouter (cloud, gratis con límites)
OPENROUTER_API_KEY=

# APIs adicionales (no usadas actualmente)
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Almacenes
WAREHOUSE_A_ID=ALM-A
WAREHOUSE_A_NAME=Almacén Norte
WAREHOUSE_B_ID=ALM-B
WAREHOUSE_B_NAME=Almacén Sur

# Sync
SYNC_INTERVAL_MINUTES=30

# Seguridad
MAX_LOGIN_ATTEMPTS=5
LOGIN_RATE_LIMIT=200/minute
# Cambiar a la IP de esta máquina en la red local + puerto 3000
ALLOWED_ORIGIN=http://localhost:3000

# DB
DATABASE_URL=sqlite:///./stock_chatbot.db
